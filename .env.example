# Sola Glow-Up environment variables
# Do not put real secrets in this file.

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional deployment override
# GitHub Pages project builds default to /sola-glow-up/.
# Use / later when a custom domain is configured.
VITE_BASE_PATH=

# Notes:
# - Supabase service-role keys must not be exposed to the Vite frontend.
# - Additional variable names should be added only when implementation requires them.
